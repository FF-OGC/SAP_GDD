{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "sourcePath",
    "sourceId",
    "group",
    "status",
    "slots",
    "states",
    "usedIn",
    "composedOf",
    "notes"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "sourcePath": {
      "type": "string",
      "minLength": 1
    },
    "sourceId": {
      "type": "string",
      "minLength": 1
    },
    "group": {
      "enum": [
        "Khung",
        "Điều khiển",
        "Hiển thị dữ liệu",
        "Ghép"
      ]
    },
    "status": {
      "enum": [
        "real",
        "runtime",
        "proposal",
        "new"
      ]
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "type",
          "path",
          "field",
          "default"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "text",
              "sprite",
              "tint",
              "active",
              "count"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "field": {
            "type": "string",
            "minLength": 1
          },
          "default": {},
          "sample": {}
        }
      }
    },
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "when",
          "ruleSource",
          "overrides"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "when": {
            "type": "string",
            "minLength": 1
          },
          "ruleSource": {
            "type": "string",
            "minLength": 1
          },
          "overrides": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "field",
                "value"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "field": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {}
              }
            }
          }
        }
      }
    },
    "usedIn": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "screen",
          "note"
        ],
        "properties": {
          "screen": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "planned": {
            "type": "boolean"
          }
        }
      }
    },
    "composedOf": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
